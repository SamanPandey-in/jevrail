# Copy to .env.local (or .env) and fill in. Never commit the real file.
#
# PostHog: https://app.posthog.com -> Project Settings
# Use the "Project API Key" (starts with phc_) — NOT a personal API key
# (starts with phx_), which is for querying the API, not for capturing events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Your project's ingestion host. US cloud is https://us.i.posthog.com,
# EU cloud is https://eu.i.posthog.com. Optional, defaults to US.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog docs also document the key as NEXT_PUBLIC_POSTHOG_KEY; either name
# works. Only set one.

# Send events from `next dev` too. Off by default so local reloads don't
# pollute production numbers. Turn on while verifying the integration.
NEXT_PUBLIC_POSTHOG_DEV=false
